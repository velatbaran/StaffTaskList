@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Personel Listesi";
}

<link href="~/datatable/buttons.datatables.css" rel="stylesheet" />
<link href="~/datatable/responsive.datatables.min.css" rel="stylesheet" />
<link href="~/datatable/datatables.min.css" rel="stylesheet" />
<link href="~/css/personel.css" rel="stylesheet" />

<div class="pr-page">

    <div class="pr-header">
        <div>
            <h1 class="pr-title">
                <span class="pr-title-icon"><i class="fa-solid fa-users"></i></span>
                Personel Listesi
            </h1>
            <div class="pr-subtitle">Tüm personel kayıtlarını görüntüleyin, arayın ve yönetin.</div>
        </div>

        <a asp-action="Create" class="pr-btn pr-btn-primary" title="Yeni Ekle">
            <i class="fa-solid fa-plus"></i> Yeni Ekle
        </a>
    </div>

    <div class="pr-table-wrap">

        <!-- Yalnızca tablo alanını kaplayan, sayfanın geri kalanını engellemeyen modern iskelet (skeleton) yükleyici -->
        <div id="loadingOverlay">
            <div class="pr-skeleton-toolbar">
                <div class="pr-skeleton-chip"></div>
                <div class="pr-skeleton-chip"></div>
                <div class="pr-skeleton-chip"></div>
                <div class="pr-skeleton-chip"></div>
                <div class="pr-skeleton-chip"></div>
            </div>
            @for (var i = 0; i < 6; i++)
            {
                <div class="pr-skeleton-row">
                    <div class="pr-skeleton-block pr-skeleton-circle"></div>
                    <div class="pr-skeleton-block" style="width:70%"></div>
                    <div class="pr-skeleton-block" style="width:55%"></div>
                    <div class="pr-skeleton-block" style="width:60%"></div>
                    <div class="pr-skeleton-block" style="width:75%"></div>
                </div>
            }
        </div>

        <table class="table table-striped pr-table" id="myTable">
            <thead>
                <tr>
                    <th></th>
                    <th>@Html.DisplayNameFor(m => m.NameSurname)</th>
                    <th>@Html.DisplayNameFor(m => m.Position)</th>
                    <th>@Html.DisplayNameFor(m => m.CreatedDate)</th>
                    <th>İşlemler</th>
                </tr>
                <tr>
                    <th></th>
                    <th><input type="text" placeholder="Ara Ad Soyad" /></th>
                    <th><input type="text" placeholder="Ara Pozisyon" /></th>
                    <th><input type="text" placeholder="Ara Kayıt Tarihi" /></th>
                    <th></th> <!-- İşlemler sütunu filtre yok -->
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th></th>
                        <td>
                            <div class="pr-name-cell">
                                <span class="pr-avatar">
                                    @(string.IsNullOrWhiteSpace(item.NameSurname) ? "?" : item.NameSurname.Trim().Substring(0, 1).ToUpper())
                                </span>
                                @Html.DisplayFor(m => item.NameSurname)
                            </div>
                        </td>
                        <td><span class="pr-badge">@Html.DisplayFor(m => item.Position)</span></td>
                        <td>@Html.DisplayFor(m => item.CreatedDate)</td>
                        <td>
                            <div class="pr-actions-cell">
                                <a class="pr-btn pr-btn-sm pr-btn-warning" asp-action="Edit" asp-route-id="@item.Id" title="Güncelle">
                                    <i class="fa-solid fa-pen-to-square"></i> Güncelle
                                </a>
                                <button type="button" class="pr-btn pr-btn-sm pr-btn-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-file-id="@item.Id" data-file-name="@($"{item.NameSurname} personelini")" title="Sil">
                                    <i class="fa-solid fa-trash"></i> Sil
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Silme Onayı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <strong id="fileName"></strong> silmek istediğine emin misin?
                    <input type="hidden" name="id" id="fileId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="pr-btn pr-btn-sm pr-btn-outline" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark"></i> İptal
                    </button>
                    <button type="submit" class="pr-btn pr-btn-sm pr-btn-danger" title="Sil">
                        <i class="fa-solid fa-trash"></i> Sil
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/datatable/datatables.min.js"></script>
    <script src="~/datatable/datatables.responsive.min.js"></script>
    <script src="~/datatable/datatables.buttons.min.js"></script>
    <script src="~/datatable/buttons.html5.min.js"></script>
    <script src="~/datatable/buttons.print.min.js"></script>
    <script src="~/datatable/jszip.min.js"></script>
    <script src="~/datatable/pdfmake.min.js"></script>
    <script src="~/datatable/vfs_fonts.js"></script>

    <script>
        // 🔹 DataTables Türkçe dil paketi (inline) — harici /datatable/tr.json isteğine bağımlı değil
        var prTrLanguage = {
            emptyTable: "Tabloda herhangi bir veri mevcut değil",
            info: "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
            infoEmpty: "Kayıt yok",
            infoFiltered: "(_MAX_ kayıt içerisinden filtrelendi)",
            lengthMenu: "Sayfada _MENU_ kayıt göster",
            loadingRecords: "Yükleniyor...",
            processing: "İşleniyor...",
            search: "Ara:",
            zeroRecords: "Eşleşen kayıt bulunamadı",
            paginate: {
                first: "İlk",
                last: "Son",
                next: "Sonraki",
                previous: "Önceki"
            },
            buttons: {
                copy: "Kopyala",
                excel: "Excel",
                csv: "CSV",
                pdf: "PDF",
                print: "Yazdır"
            }
        };

        // 🔹 Türkçe normalize fonksiyonu
        function normalizeTr(text) {
            if (!text) return "";

            return text.toString()
                .toLowerCase()
                .replace(/ı/g, "i")
                .replace(/İ/g, "i")
                .replace(/i̇/g, "i")
                .replace(/ğ/g, "g")
                .replace(/ü/g, "u")
                .replace(/ş/g, "s")
                .replace(/ö/g, "o")
                .replace(/ç/g, "c");
        }

        $(document).ready(function () {

            // Modal tetikleme
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                $('#fileId').val(button.data('file-id'));
                $('#fileName').text(button.data('file-name'));
            });

            // 🔹 Türkçe uyumlu custom search
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

                var nameSurnameInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(1) input').val());
                var PositionInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(2) input').val());
                var createdDateInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(3) input').val());

                var rowNameSurname = normalizeTr(data[1]);   // ad soyad
                var rowPosition = normalizeTr(data[2]);  // pozisyon
                var rowCreatedDate = normalizeTr(data[3]); // kayıt tarih

                if (nameSurnameInput && !rowNameSurname.includes(nameSurnameInput)) return false;
                if (PositionInput && !rowPosition.includes(PositionInput)) return false;
                if (createdDateInput && !rowCreatedDate.includes(createdDateInput)) return false;

                return true;
            });

            // DataTable başlat
            var table = $('#myTable').DataTable({
                dom: 'Brtip',
                buttons: ['copy', 'excel', 'csv', 'pdf', 'print'],
                ordering: false,
                paging: true,
                pageLength: 10,
                info: true,
                responsive: {
                    details: { type: 'column', target: 0 }
                },
                columnDefs: [
                    { className: 'control', orderable: false, targets: 0 },
                    { orderable: false, targets: -1 }
                ],

                language: prTrLanguage,

                initComplete: function () {
                    hideTableSkeleton();
                }
            });

            setTimeout(hideTableSkeleton, 1500);

            function hideTableSkeleton() {
                var $overlay = $('#loadingOverlay');
                if (!$overlay.hasClass('pr-hidden')) {
                    $overlay.addClass('pr-hidden');
                    setTimeout(function () { $overlay.remove(); }, 250);
                }
            }

            // 🔹 Input değişince sadece draw çağır
            $('#myTable thead tr:eq(1) th input').on('keyup change clear', function () {
                table.draw();
            });

        });
    </script>
}
