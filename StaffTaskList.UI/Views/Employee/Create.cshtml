@model Employee
@{
    ViewData["Title"] = "Personel Ekle";
}

<link href="~/css/personel.css" rel="stylesheet" />

<div class="pr-page">

    <div class="pr-header">
        <div>
            <h1 class="pr-title">
                <span class="pr-title-icon"><i class="fa-solid fa-user-plus"></i></span>
                Personel Ekle
            </h1>
            <div class="pr-subtitle">Yeni personel bilgilerini girin.</div>
        </div>
    </div>

    <div class="pr-card pr-form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="pr-validation-summary"></div>

            <div class="pr-form-group">
                <label asp-for="NameSurname" class="pr-label"></label>
                <input asp-for="NameSurname" class="pr-input" placeholder="Örn. Ahmet Yılmaz" autocomplete="off" />
                <span asp-validation-for="NameSurname" class="text-danger"></span>
            </div>

            <div class="pr-form-group">
                <label asp-for="Position" class="pr-label"></label>
                <input asp-for="Position" class="pr-input" placeholder="Örn. Yazılım Geliştirici" autocomplete="off" />
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>

            <div class="pr-form-actions">
                <button type="submit" value="Ekle" class="pr-btn pr-btn-success" title="Ekle">
                    <i class="fa-solid fa-floppy-disk"></i> Ekle
                </button>
                <a href="/personeller" class="pr-btn pr-btn-outline" title="İptal">
                    <i class="fa-solid fa-ban"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
