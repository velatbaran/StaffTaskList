@model IEnumerable<TaskViewModel>

@{
    ViewData["Title"] = "Uzatılan Görev Listesi";
}

<link href="~/datatable/buttons.datatables.css" rel="stylesheet" />
<link href="~/datatable/responsive.datatables.min.css" rel="stylesheet" />
<link href="~/datatable/datatables.min.css" rel="stylesheet" />
<link href="~/css/gorev.css" rel="stylesheet" />

<div class="tg-page">

    <div class="tg-header">

        <div>

            <h1 class="tg-title">

                <span class="tg-title-icon">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </span>

                Uzatılan Görevler

            </h1>

            <div class="tg-subtitle">
                Süresi uzatılan görev kayıtlarını ve geçmiş işlemlerini görüntüleyin.
            </div>

        </div>

    </div>


    <div class="tg-table-wrap">

        <table class="table tg-table" id="myTable">

            <thead>

                <tr>

                    <th></th>

                    <th>@Html.DisplayNameFor(m => m.Employee)</th>

                    <th>@Html.DisplayNameFor(m => m.PlaceGone)</th>

                    <th>@Html.DisplayNameFor(m => m.ArrivalDate)</th>

                    <th>@Html.DisplayNameFor(m => m.ActiveDepartureDate)</th>

                    <th>@Html.DisplayNameFor(m => m.TotalDay)</th>

                    <th>@Html.DisplayNameFor(m => m.ActiveDescription)</th>

                    <th>@Html.DisplayNameFor(m => m.CreatedDate)</th>

                    <th>Aksiyon</th>

                </tr>


                <tr class="tg-filter-row">

                    <th></th>

                    <th>
                        <input type="text" placeholder="Ara Personel" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Gidilen Yer" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Varış Tarihi" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Ayrılış Tarihi" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Toplam Gün" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Açıklama" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Kayıt Tarihi" />
                    </th>

                    <th></th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td></td>


                        <td>

                            <div class="tg-person-cell">

                                <span class="tg-avatar">
                                    @(string.IsNullOrWhiteSpace(item.Employee)
                                        ? "?"
                                        : item.Employee.Trim().Substring(0, 1).ToUpper())
                                </span>

                                <span class="tg-person-name">
                                    @item.Employee
                                </span>

                            </div>

                        </td>


                        <td>

                            <span class="tg-location">
                                <i class="fa-solid fa-location-dot"></i>
                                @item.PlaceGone
                            </span>

                        </td>


                        <td>

                            <span class="tg-date">
                                @item.ArrivalDate
                            </span>

                        </td>


                        <td>

                            <span class="tg-date tg-date-success">
                                @item.ActiveDepartureDate
                            </span>

                        </td>


                        <td>

                            <span class="tg-day-badge tg-day-success">
                                @item.TotalDay gün
                            </span>

                        </td>


                        <td>

                            <span class="tg-description">
                                @item.ActiveDescription
                            </span>

                        </td>


                        <td>

                            <span class="tg-created-date">
                                @item.CreatedDate
                            </span>

                        </td>


                        <td>

                            <div class="tg-actions-cell">

                                <a class="tg-btn tg-btn-history"
                                   asp-action="ExtendedTasksOne"
                                   asp-route-id="@item.Id"
                                   title="Geçmiş">

                                    <i class="fa-solid fa-clock-rotate-left"></i>

                                    Geçmiş

                                    <span class="tg-count">
                                        @item.ExtensionCount
                                    </span>

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


@section Scripts {

    <script src="~/datatable/datatables.min.js"></script>
    <script src="~/datatable/datatables.responsive.min.js"></script>
    <script src="~/datatable/datatables.buttons.min.js"></script>
    <script src="~/datatable/buttons.html5.min.js"></script>
    <script src="~/datatable/buttons.print.min.js"></script>
    <script src="~/datatable/jszip.min.js"></script>
    <script src="~/datatable/pdfmake.min.js"></script>
    <script src="~/datatable/vfs_fonts.js"></script>


    <script>

        function normalizeTr(text) {

            if (!text)
                return "";

            return text.toString()
                .toLowerCase()
                .replace(/ı/g, "i")
                .replace(/İ/g, "i")
                .replace(/i̇/g, "i")
                .replace(/ğ/g, "g")
                .replace(/ü/g, "u")
                .replace(/ş/g, "s")
                .replace(/ö/g, "o")
                .replace(/ç/g, "c");

        }


        $(document).ready(function () {

            $.fn.dataTable.ext.search.push(function (settings, data) {

                var inputs = [];

                $('#myTable thead tr:eq(1) th input').each(function () {
                    inputs.push(normalizeTr($(this).val()));
                });


                for (var i = 1; i <= 7; i++) {

                    if (
                        inputs[i] &&
                        !normalizeTr(data[i]).includes(inputs[i])
                    ) {
                        return false;
                    }

                }

                return true;

            });


            var table = $('#myTable').DataTable({

                dom: 'Brtip',

                buttons: [
                    'copy',
                    'excel',
                    'csv',
                    'pdf',
                    'print'
                ],

                ordering: false,

                paging: true,

                pageLength: 10,

                info: true,

                responsive: {
                    details: {
                        type: 'column',
                        target: 0
                    }
                },

                columnDefs: [
                    {
                        className: 'control',
                        orderable: false,
                        targets: 0
                    },

                    {
                        orderable: false,
                        targets: -1
                    }
                ],

                language: {
                    url: '/datatable/tr.json'
                }

            });


            $('#myTable thead tr:eq(1) th input')
                .on('keyup change clear', function () {

                    table.draw();

                });

        });

    </script>
}