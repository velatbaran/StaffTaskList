@model AddTaskViewModel

@{
    ViewData["Title"] = "Görev Ekle";
}

<link href="~/css/gorevler.css" rel="stylesheet" />

<div class="pr-page">
    <div class="pr-header">
        <div>
            <h1 class="pr-title">
                <span class="pr-title-icon"><i class="fa-solid fa-plus-circle"></i></span>
                Görev Ekle
            </h1>
            <div class="pr-subtitle">Sisteme yeni bir görev kaydı tanımlayın.</div>
        </div>
    </div>

    <div class="pr-card" style="max-width: 720px;">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="pr-form-group">
                <label asp-for="EmployeeId"></label>
                <div>
                    <select asp-for="EmployeeId" class="pr-form-control select2" asp-items="ViewBag.Employee">
                        <option></option>
                    </select>
                </div>
                <span asp-validation-for="EmployeeId" class="text-danger font-weight-bold"></span>
            </div>

            <div class="pr-form-group">
                <label asp-for="PlaceGone"></label>
                <input asp-for="PlaceGone" class="pr-form-control" placeholder="Gidilecek yeri yazınız" />
                <span asp-validation-for="PlaceGone" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="pr-form-group">
                        <label asp-for="ArrivalDate"></label>
                        <input type="date" asp-for="ArrivalDate" class="pr-form-control" />
                        <span asp-validation-for="ArrivalDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="pr-form-group">
                        <label asp-for="NewDepartureDate"></label>
                        <input type="date" asp-for="NewDepartureDate" class="pr-form-control" />
                        <span asp-validation-for="NewDepartureDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="pr-form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="pr-form-control" rows="3" placeholder="Görev detayları..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="pr-btn pr-btn-success">
                    <i class="fa-solid fa-floppy-disk"></i> Kaydet
                </button>
                <a href="/gorevler" class="pr-btn pr-btn-outline">
                    <i class="fa-solid fa-ban"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: "Personel seçiniz...",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}