@model IEnumerable<TaskViewModel>

@{
    ViewData["Title"] = "Uzatılmayan Görev Listesi";
}

<link href="~/datatable/buttons.datatables.css" rel="stylesheet" />
<link href="~/datatable/responsive.datatables.min.css" rel="stylesheet" />
<link href="~/datatable/datatables.min.css" rel="stylesheet" />
<link href="~/css/gorev.css" rel="stylesheet" />

<div class="tg-page">

    <!-- SAYFA BAŞLIĞI -->
    <div class="tg-header">
        <div>
            <h1 class="tg-title">
                <span class="tg-title-icon">
                    <i class="fa-solid fa-list-check"></i>
                </span>
                Uzatılmayan Görevler
            </h1>

            <div class="tg-subtitle">
                Süresi uzatılmamış görev kayıtlarını görüntüleyin ve takip edin.
            </div>
        </div>
    </div>


    <!-- TABLO -->
    <div class="tg-table-wrap">

        <table class="table tg-table" id="myTable">

            <thead>
                <tr>
                    <th></th>
                    <th>@Html.DisplayNameFor(m => m.Employee)</th>
                    <th>@Html.DisplayNameFor(m => m.PlaceGone)</th>
                    <th>@Html.DisplayNameFor(m => m.ArrivalDate)</th>
                    <th>@Html.DisplayNameFor(m => m.ActiveDepartureDate)</th>
                    <th>@Html.DisplayNameFor(m => m.TotalDay)</th>
                    <th>@Html.DisplayNameFor(m => m.ActiveDescription)</th>
                    <th>@Html.DisplayNameFor(m => m.CreatedDate)</th>
                </tr>

                <tr class="tg-filter-row">
                    <th></th>

                    <th>
                        <input type="text" placeholder="Ara Personel" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Gidilen Yer" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Varış Tarihi" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Ayrılış Tarihi" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Toplam Gün" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Açıklama" />
                    </th>

                    <th>
                        <input type="text" placeholder="Ara Kayıt Tarihi" />
                    </th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td></td>

                        <td>
                            <div class="tg-person-cell">

                                <span class="tg-avatar">
                                    @(string.IsNullOrWhiteSpace(item.Employee)
                                        ? "?"
                                        : item.Employee.Trim().Substring(0, 1).ToUpper())
                                </span>

                                <span class="tg-person-name">
                                    @item.Employee
                                </span>

                            </div>
                        </td>

                        <td>
                            <span class="tg-location">
                                <i class="fa-solid fa-location-dot"></i>
                                @item.PlaceGone
                            </span>
                        </td>

                        <td>
                            <span class="tg-date">
                                @item.ArrivalDate
                            </span>
                        </td>

                        <td>
                            <span class="tg-date tg-date-danger">
                                @item.ActiveDepartureDate
                            </span>
                        </td>

                        <td>
                            <span class="tg-day-badge">
                                @item.TotalDay gün
                            </span>
                        </td>

                        <td>
                            <span class="tg-description">
                                @item.ActiveDescription
                            </span>
                        </td>

                        <td>
                            <span class="tg-created-date">
                                @item.CreatedDate
                            </span>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


@section Scripts {

    <script src="~/datatable/datatables.min.js"></script>
    <script src="~/datatable/datatables.responsive.min.js"></script>
    <script src="~/datatable/datatables.buttons.min.js"></script>
    <script src="~/datatable/buttons.html5.min.js"></script>
    <script src="~/datatable/buttons.print.min.js"></script>
    <script src="~/datatable/jszip.min.js"></script>
    <script src="~/datatable/pdfmake.min.js"></script>
    <script src="~/datatable/vfs_fonts.js"></script>

    <script>

        function normalizeTr(text) {

            if (!text)
                return "";

            return text.toString()
                .toLowerCase()
                .replace(/ı/g, "i")
                .replace(/İ/g, "i")
                .replace(/i̇/g, "i")
                .replace(/ğ/g, "g")
                .replace(/ü/g, "u")
                .replace(/ş/g, "s")
                .replace(/ö/g, "o")
                .replace(/ç/g, "c");
        }


        $(document).ready(function () {

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

                var employeeInput =
                    normalizeTr($('#myTable thead tr:eq(1) th:eq(1) input').val());

                var placeGoneInput =
                    normalizeTr($('#myTable thead tr:eq(1) th:eq(2) input').val());

                var arrivalDateInput =
                    normalizeTr($('#myTable thead tr:eq(1) th:eq(3) input').val());

                var activeDepartureDateInput =
                    normalizeTr($('#myTable thead tr:eq(1) th:eq(4) input').val());

                var totalDayInput =
                    normalizeTr($('#myTable thead tr:eq(1) th:eq(5) input').val());

                var descriptionInput =
                    normalizeTr($('#myTable thead tr:eq(1) th:eq(6) input').val());

                var createdDateInput =
                    normalizeTr($('#myTable thead tr:eq(1) th:eq(7) input').val());


                var rowEmployee = normalizeTr(data[1]);
                var rowPlaceGone = normalizeTr(data[2]);
                var rowArrivalDate = normalizeTr(data[3]);
                var rowActiveDepartureDate = normalizeTr(data[4]);
                var rowTotalDay = normalizeTr(data[5]);
                var rowDescription = normalizeTr(data[6]);
                var rowCreatedDate = normalizeTr(data[7]);


                if (employeeInput &&
                    !rowEmployee.includes(employeeInput))
                    return false;

                if (placeGoneInput &&
                    !rowPlaceGone.includes(placeGoneInput))
                    return false;

                if (arrivalDateInput &&
                    !rowArrivalDate.includes(arrivalDateInput))
                    return false;

                if (activeDepartureDateInput &&
                    !rowActiveDepartureDate.includes(activeDepartureDateInput))
                    return false;

                if (totalDayInput &&
                    !rowTotalDay.includes(totalDayInput))
                    return false;

                if (descriptionInput &&
                    !rowDescription.includes(descriptionInput))
                    return false;

                if (createdDateInput &&
                    !rowCreatedDate.includes(createdDateInput))
                    return false;

                return true;
            });


            var table = $('#myTable').DataTable({

                dom: 'Brtip',

                buttons: [
                    'copy',
                    'excel',
                    'csv',
                    'pdf',
                    'print'
                ],

                ordering: false,

                paging: true,

                pageLength: 10,

                info: true,

                responsive: {
                    details: {
                        type: 'column',
                        target: 0
                    }
                },

                columnDefs: [
                    {
                        className: 'control',
                        orderable: false,
                        targets: 0
                    }
                ],

                language: {
                    url: '/datatable/tr.json'
                }

            });


            $('#myTable thead tr:eq(1) th input')
                .on('keyup change clear', function () {

                    table.draw();

                });

        });

    </script>
}