@model IEnumerable<TaskViewModel>

@{
    ViewData["Title"] = "Uzatılmayan Görev Listesi";
}

<link href="~/datatable/buttons.datatables.css" rel="stylesheet" />
<link href="~/datatable/responsive.datatables.min.css" rel="stylesheet" />
<link href="~/datatable/datatables.min.css" rel="stylesheet" />
<link href="~/css/gorev.css" rel="stylesheet" />


<div class="tg-page">

    <!-- ===================================================== -->
    <!-- SAYFA BAŞLIĞI -->
    <!-- ===================================================== -->

    <div class="tg-header">

        <div>

            <h1 class="tg-title">

                <span class="tg-title-icon">
                    <i class="fa-solid fa-list-check"></i>
                </span>

                Uzatılmayan Görevler

            </h1>


            <div class="tg-subtitle">

                Süresi uzatılmamış görev kayıtlarını görüntüleyin ve takip edin.

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TABLO -->
    <!-- ===================================================== -->

    <div class="tg-table-wrap">

        <table class="table tg-table" id="myTable">

            <thead>

                <!-- TABLO BAŞLIKLARI -->

                <tr>

                    <th></th>

                    <th>
                        @Html.DisplayNameFor(m => m.Employee)
                    </th>

                    <th>
                        @Html.DisplayNameFor(m => m.PlaceGone)
                    </th>

                    <th>
                        @Html.DisplayNameFor(m => m.ArrivalDate)
                    </th>

                    <th>
                        @Html.DisplayNameFor(m => m.ActiveDepartureDate)
                    </th>

                    <th>
                        @Html.DisplayNameFor(m => m.TotalDay)
                    </th>

                    <th>
                        @Html.DisplayNameFor(m => m.ActiveDescription)
                    </th>

                    <th>
                        @Html.DisplayNameFor(m => m.CreatedDate)
                    </th>

                    <th class="text-end">
                        İşlemler
                    </th>

                </tr>


                <!-- ================================================= -->
                <!-- FİLTRE SATIRI -->
                <!-- ================================================= -->

                <tr class="tg-filter-row">

                    <th></th>

                    <th>
                        <input type="text"
                               placeholder="Ara Personel" />
                    </th>

                    <th>
                        <input type="text"
                               placeholder="Ara Gidilen Yer" />
                    </th>

                    <th>
                        <input type="text"
                               placeholder="Ara Varış Tarihi" />
                    </th>

                    <th>
                        <input type="text"
                               placeholder="Ara Ayrılış Tarihi" />
                    </th>

                    <th>
                        <input type="text"
                               placeholder="Ara Toplam Gün" />
                    </th>

                    <th>
                        <input type="text"
                               placeholder="Ara Açıklama" />
                    </th>

                    <th>
                        <input type="text"
                               placeholder="Ara Kayıt Tarihi" />
                    </th>

                    <th></th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <!-- RESPONSIVE CONTROL -->

                        <td></td>


                        <!-- ================================================= -->
                        <!-- PERSONEL -->
                        <!-- ================================================= -->

                        <td>

                            <div class="tg-person-cell">

                                <span class="tg-avatar">

                                    @(string.IsNullOrWhiteSpace(item.Employee)
                                        ? "?"
                                        : item.Employee.Trim().Substring(0, 1).ToUpper())

                                </span>


                                <span class="tg-person-name">

                                    @item.Employee

                                </span>

                            </div>

                        </td>


                        <!-- ================================================= -->
                        <!-- GİDİLEN YER -->
                        <!-- ================================================= -->

                        <td>

                            <span class="tg-location">

                                <i class="fa-solid fa-location-dot"></i>

                                @item.PlaceGone

                            </span>

                        </td>


                        <!-- ================================================= -->
                        <!-- VARIŞ -->
                        <!-- ================================================= -->

                        <td>

                            <span class="tg-date">

                                @item.ArrivalDate

                            </span>

                        </td>


                        <!-- ================================================= -->
                        <!-- AYRILIŞ -->
                        <!-- ================================================= -->

                        <td>

                            <span class="tg-date tg-date-danger">

                                @item.ActiveDepartureDate

                            </span>

                        </td>


                        <!-- ================================================= -->
                        <!-- TOPLAM GÜN -->
                        <!-- ================================================= -->

                        <td>

                            <span class="tg-day-badge">

                                @item.TotalDay gün

                            </span>

                        </td>


                        <!-- ================================================= -->
                        <!-- AÇIKLAMA -->
                        <!-- ================================================= -->

                        <td>

                            <span class="tg-description">

                                @item.ActiveDescription

                            </span>

                        </td>


                        <!-- ================================================= -->
                        <!-- KAYIT TARİHİ -->
                        <!-- ================================================= -->

                        <td>

                            <span class="tg-created-date">

                                @item.CreatedDate

                            </span>

                        </td>


                        <!-- ================================================= -->
                        <!-- İŞLEMLER -->
                        <!-- ================================================= -->

                        <td>

                            <div class="tg-actions-cell"
                                 style="justify-content:flex-end;">

                                <!-- DETAY BUTONU -->

                                <button type="button"
                                        class="tg-detail-btn"
                                        title="Görev Detaylarını Görüntüle"
                                        data-bs-toggle="modal"
                                        data-bs-target="#taskDetailModal"
                                        data-employee="@item.Employee"
                                        data-place="@item.PlaceGone"
                                        data-arrival="@item.ArrivalDate"
                                        data-departure="@item.ActiveDepartureDate"
                                        data-totalday="@item.TotalDay"
                                        data-description="@item.ActiveDescription"
                                        data-created="@item.CreatedDate">

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- ========================================================= -->
<!-- GÖREV DETAY MODALI -->
<!-- ========================================================= -->

<div class="modal fade"
     id="taskDetailModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content task-detail-modal">


            <!-- ================================================= -->
            <!-- MODAL HEADER -->
            <!-- ================================================= -->

            <div class="modal-header task-detail-header">

                <div class="task-detail-title">


                    <span class="task-detail-icon">

                        <i class="fa-solid fa-clipboard-list"></i>

                    </span>


                    <div>

                        <h5>
                            Görev Detayları
                        </h5>

                        <span>
                            Uzatılmayan görev kayıt bilgileri
                        </span>

                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Kapat">
                </button>

            </div>


            <!-- ================================================= -->
            <!-- MODAL BODY -->
            <!-- ================================================= -->

            <div class="modal-body task-detail-body">


                <!-- ================================================= -->
                <!-- PERSONEL -->
                <!-- ================================================= -->

                <div class="task-detail-main">

                    <div class="task-detail-avatar">

                        <i class="fa-solid fa-user"></i>

                    </div>


                    <div>

                        <div class="task-detail-label">
                            PERSONEL
                        </div>


                        <div id="detailEmployee"
                             class="task-detail-employee">
                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- BİLGİLER -->
                <!-- ================================================= -->

                <div class="task-detail-grid">


                    <!-- GİDİLEN YER -->

                    <div class="task-detail-item">

                        <div class="task-detail-item-icon">

                            <i class="fa-solid fa-location-dot"></i>

                        </div>


                        <div>

                            <span>
                                Gidilen Yer
                            </span>

                            <strong id="detailPlace"></strong>

                        </div>

                    </div>


                    <!-- VARIŞ -->

                    <div class="task-detail-item">

                        <div class="task-detail-item-icon">

                            <i class="fa-solid fa-plane-arrival"></i>

                        </div>


                        <div>

                            <span>
                                Varış Tarihi
                            </span>

                            <strong id="detailArrival"></strong>

                        </div>

                    </div>


                    <!-- AYRILIŞ -->

                    <div class="task-detail-item">

                        <div class="task-detail-item-icon">

                            <i class="fa-solid fa-plane-departure"></i>

                        </div>


                        <div>

                            <span>
                                Ayrılış Tarihi
                            </span>

                            <strong id="detailDeparture"></strong>

                        </div>

                    </div>


                    <!-- TOPLAM GÜN -->

                    <div class="task-detail-item">

                        <div class="task-detail-item-icon">

                            <i class="fa-regular fa-clock"></i>

                        </div>


                        <div>

                            <span>
                                Toplam Süre
                            </span>

                            <strong id="detailTotalDay"></strong>

                        </div>

                    </div>


                    <!-- KAYIT TARİHİ -->

                    <div class="task-detail-item">

                        <div class="task-detail-item-icon">

                            <i class="fa-regular fa-calendar"></i>

                        </div>


                        <div>

                            <span>
                                Kayıt Tarihi
                            </span>

                            <strong id="detailCreated"></strong>

                        </div>

                    </div>


                    <!-- DURUM -->

                    <div class="task-detail-item">

                        <div class="task-detail-item-icon">

                            <i class="fa-solid fa-circle-info"></i>

                        </div>


                        <div>

                            <span>
                                Durum
                            </span>

                            <strong class="task-status-pending">
                                Uzatılmadı
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- AÇIKLAMA -->
                <!-- ================================================= -->

                <div class="task-detail-description">

                    <div class="task-detail-description-header">

                        <i class="fa-solid fa-align-left"></i>

                        Açıklama

                    </div>


                    <div id="detailDescription"
                         class="task-detail-description-content">
                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- MODAL FOOTER -->
            <!-- ================================================= -->

            <div class="modal-footer task-detail-footer">

                <button type="button"
                        class="pr-btn pr-btn-outline"
                        data-bs-dismiss="modal">

                    <i class="fa-solid fa-xmark"></i>

                    Kapat

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/datatable/datatables.min.js"></script>

    <script src="~/datatable/datatables.responsive.min.js"></script>

    <script src="~/datatable/datatables.buttons.min.js"></script>

    <script src="~/datatable/buttons.html5.min.js"></script>

    <script src="~/datatable/buttons.print.min.js"></script>

    <script src="~/datatable/jszip.min.js"></script>

    <script src="~/datatable/pdfmake.min.js"></script>

    <script src="~/datatable/vfs_fonts.js"></script>


    <script>

        // =====================================================
        // TÜRKÇE NORMALİZASYON
        // =====================================================

        function normalizeTr(text) {

            if (!text)
                return "";

            return text.toString()
                .toLowerCase()
                .replace(/ı/g, "i")
                .replace(/İ/g, "i")
                .replace(/i̇/g, "i")
                .replace(/ğ/g, "g")
                .replace(/ü/g, "u")
                .replace(/ş/g, "s")
                .replace(/ö/g, "o")
                .replace(/ç/g, "c");
        }


        $(document).ready(function () {


            // =================================================
            // DETAY MODALI
            // =================================================

            $('#taskDetailModal').on(
                'show.bs.modal',
                function (event) {

                    var button = $(event.relatedTarget);


                    // PERSONEL

                    $('#detailEmployee').text(
                        button.attr('data-employee') || '-'
                    );


                    // GİDİLEN YER

                    $('#detailPlace').text(
                        button.attr('data-place') || '-'
                    );


                    // VARIŞ

                    $('#detailArrival').text(
                        button.attr('data-arrival') || '-'
                    );


                    // AYRILIŞ

                    $('#detailDeparture').text(
                        button.attr('data-departure') || '-'
                    );


                    // TOPLAM GÜN

                    var totalDay =
                        button.attr('data-totalday');


                    $('#detailTotalDay').text(
                        totalDay
                            ? totalDay + ' Gün'
                            : '-'
                    );


                    // KAYIT TARİHİ

                    $('#detailCreated').text(
                        button.attr('data-created') || '-'
                    );


                    // AÇIKLAMA

                    $('#detailDescription').text(
                        button.attr('data-description')
                            || 'Açıklama bulunmuyor.'
                    );

                }
            );


            // =================================================
            // TÜRKÇE ÖZEL FİLTRE
            // =================================================

            $.fn.dataTable.ext.search.push(function (
                settings,
                data,
                dataIndex
            ) {

                var employeeInput =
                    normalizeTr(
                        $('#myTable thead tr:eq(1) th:eq(1) input').val()
                    );


                var placeGoneInput =
                    normalizeTr(
                        $('#myTable thead tr:eq(1) th:eq(2) input').val()
                    );


                var arrivalDateInput =
                    normalizeTr(
                        $('#myTable thead tr:eq(1) th:eq(3) input').val()
                    );


                var activeDepartureDateInput =
                    normalizeTr(
                        $('#myTable thead tr:eq(1) th:eq(4) input').val()
                    );


                var totalDayInput =
                    normalizeTr(
                        $('#myTable thead tr:eq(1) th:eq(5) input').val()
                    );


                var descriptionInput =
                    normalizeTr(
                        $('#myTable thead tr:eq(1) th:eq(6) input').val()
                    );


                var createdDateInput =
                    normalizeTr(
                        $('#myTable thead tr:eq(1) th:eq(7) input').val()
                    );


                var rowEmployee =
                    normalizeTr(data[1]);


                var rowPlaceGone =
                    normalizeTr(data[2]);


                var rowArrivalDate =
                    normalizeTr(data[3]);


                var rowActiveDepartureDate =
                    normalizeTr(data[4]);


                var rowTotalDay =
                    normalizeTr(data[5]);


                var rowDescription =
                    normalizeTr(data[6]);


                var rowCreatedDate =
                    normalizeTr(data[7]);


                if (
                    employeeInput &&
                    !rowEmployee.includes(employeeInput)
                )
                    return false;


                if (
                    placeGoneInput &&
                    !rowPlaceGone.includes(placeGoneInput)
                )
                    return false;


                if (
                    arrivalDateInput &&
                    !rowArrivalDate.includes(arrivalDateInput)
                )
                    return false;


                if (
                    activeDepartureDateInput &&
                    !rowActiveDepartureDate.includes(activeDepartureDateInput)
                )
                    return false;


                if (
                    totalDayInput &&
                    !rowTotalDay.includes(totalDayInput)
                )
                    return false;


                if (
                    descriptionInput &&
                    !rowDescription.includes(descriptionInput)
                )
                    return false;


                if (
                    createdDateInput &&
                    !rowCreatedDate.includes(createdDateInput)
                )
                    return false;


                return true;

            });


            // =================================================
            // DATATABLE
            // =================================================

            var table =
                $('#myTable').DataTable({

                    dom: 'Brtip',

                    buttons: [

                        'copy',
                        'excel',
                        'csv',
                        'pdf',
                        'print'

                    ],

                    ordering: false,

                    paging: true,

                    pageLength: 10,

                    info: true,

                    responsive: {

                        details: {

                            type: 'column',

                            target: 0

                        }

                    },

                    columnDefs: [

                        {
                            className: 'control',
                            orderable: false,
                            targets: 0
                        },

                        {
                            orderable: false,
                            targets: -1
                        }

                    ],

                    language: {

                        url: '/datatable/tr.json'

                    }

                });


            // =================================================
            // FİLTRELER
            // =================================================

            $('#myTable thead tr:eq(1) th input')
                .on(
                    'keyup change clear',
                    function () {

                        table.draw();

                    }
                );

        });

    </script>

}