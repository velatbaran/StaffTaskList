
@model ForgetPasswordViewModel

@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Şifremi Unuttum";
}


<link href="~/css/login.css" rel="stylesheet" />

<div class="forgot-page">

    <!-- Arka plan -->

    <div class="forgot-bg-shape one"></div>
    <div class="forgot-bg-shape two"></div>


    <div class="forgot-container">


        <!-- =====================================================
             SOL KURUMSAL ALAN
             ===================================================== -->

        <div class="forgot-brand-panel">

            <div class="forgot-brand-content">

                <div class="forgot-logo-box">

                    <img src="~/images/makinaikmal.png"
                         alt="Makina İmalat ve Donatım Şube Müdürlüğü" />

                </div>


                <div class="forgot-kicker">

                    <i class="fa-solid fa-circle"></i>

                    Personel Yönetim Sistemi

                </div>


                <h2 class="forgot-brand-title">

                    Makina İmalat ve Donatım
                    Şube Müdürlüğü

                </h2>


                <p class="forgot-brand-description">

                    Personel görev ve görevlendirme süreçlerinizi
                    tek bir platform üzerinden güvenli ve kolay
                    bir şekilde yönetin.

                </p>

            </div>


            <div class="forgot-brand-footer">

                <span class="forgot-brand-footer-line"></span>

                <span>
                    DSİ Personel Görev Yönetim Sistemi
                </span>

            </div>

        </div>


        <!-- =====================================================
             SAĞ ŞİFRE FORMU
             ===================================================== -->

        <div class="forgot-form-panel">

            <div class="forgot-form-container">


                <div class="forgot-heading">

                    <div class="forgot-heading-icon">

                        <i class="fa-solid fa-key"></i>

                    </div>


                    <h1>
                        Yeni Şifre Oluştur
                    </h1>


                    <p>
                        Hesabınız için yeni bir şifre belirlemek
                        üzere aşağıdaki bilgileri doldurun.
                    </p>

                </div>


                <div class="forgot-warning">

                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Lütfen sistemde kayıtlı olan
                        <strong>kullanıcı adınızı</strong>
                        giriniz. Yeni şifreniz güvenli bir şekilde
                        oluşturulacaktır.
                    </span>

                </div>


                <form method="post"
                      asp-action="ForgetPassword"
                      asp-controller="Account">


                    <div asp-validation-summary="ModelOnly"
                         class="forgot-validation">
                    </div>


                    <!-- Kullanıcı adı -->

                    <div class="forgot-form-group">

                        <label asp-for="Username"
                               class="forgot-label">

                            Kullanıcı Adı

                        </label>


                        <div class="forgot-input-wrapper">

                            <i class="fa-solid fa-user forgot-input-icon"></i>


                            <input asp-for="Username"
                                   class="forgot-input"
                                   placeholder="Kullanıcı adınızı giriniz..."
                                   autocomplete="username" />

                        </div>


                        <span asp-validation-for="Username"
                              class="forgot-validation-message">
                        </span>

                    </div>


                    <!-- Yeni şifre -->

                    <div class="forgot-form-group">

                        <label asp-for="Password"
                               class="forgot-label">

                            Yeni Şifre

                        </label>


                        <div class="forgot-input-wrapper">

                            <i class="fa-solid fa-lock forgot-input-icon"></i>


                            <input type="password"
                                   asp-for="Password"
                                   class="forgot-input"
                                   placeholder="Yeni şifrenizi giriniz..."
                                   autocomplete="new-password" />

                        </div>


                        <span asp-validation-for="Password"
                              class="forgot-validation-message">
                        </span>

                    </div>


                    <!-- Yeni şifre tekrar -->

                    <div class="forgot-form-group">

                        <label asp-for="RePassword"
                               class="forgot-label">

                            Yeni Şifre Tekrar

                        </label>


                        <div class="forgot-input-wrapper">

                            <i class="fa-solid fa-lock-keyhole forgot-input-icon"></i>


                            <input type="password"
                                   asp-for="RePassword"
                                   class="forgot-input"
                                   placeholder="Yeni şifrenizi tekrar giriniz..."
                                   autocomplete="new-password" />

                        </div>


                        <span asp-validation-for="RePassword"
                              class="forgot-validation-message">
                        </span>

                    </div>


                    <!-- Butonlar -->

                    <div class="forgot-actions">


                        <button type="submit"
                                class="forgot-submit">

                            <i class="fa-solid fa-key"></i>

                            <span>
                                Şifreyi Değiştir
                            </span>

                        </button>


                        <a href="/giris"
                           class="forgot-back">

                            <i class="fa-solid fa-arrow-left"></i>

                            <span>
                                Giriş Sayfası
                            </span>

                        </a>


                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

